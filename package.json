{
  "name": "branch-reviewer",
  "displayName": "Branch Reviewer",
  "description": "Review local branch history one commit at a time",
  "version": "0.0.1",
  "publisher": "bitwizeshift",
  "engines": {
    "vscode": "^1.139.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "branchReviewer.refresh",
        "title": "Refresh",
        "category": "Branch Reviewer",
        "icon": "$(refresh)"
      },
      {
        "command": "branchReviewer.abort",
        "title": "Abort Review",
        "category": "Branch Reviewer",
        "icon": "$(debug-stop)"
      },
      {
        "command": "branchReviewer.showLog",
        "title": "Show Log",
        "category": "Branch Reviewer"
      },
      {
        "command": "branchReviewer.files.showChangedOnly",
        "title": "Show Only Changed Files",
        "category": "Branch Reviewer",
        "icon": "$(filter)"
      },
      {
        "command": "branchReviewer.files.showAll",
        "title": "Show All Files",
        "category": "Branch Reviewer",
        "icon": "$(filter-filled)"
      },
      {
        "command": "branchReviewer.openChanges",
        "title": "Open Changes",
        "category": "Branch Reviewer",
        "icon": "$(git-compare)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branchReviewer",
          "title": "Branch Reviewer",
          "icon": "media/branch-reviewer.svg"
        }
      ]
    },
    "views": {
      "branchReviewer": [
        {
          "id": "branchReviewer.review",
          "name": "Review",
          "type": "webview"
        },
        {
          "id": "branchReviewer.files",
          "name": "Files Changed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "branchReviewer.files",
        "contents": "Start a review to browse the files changed by each commit.",
        "when": "!branchReviewer.reviewing && !branchReviewer.noRepository"
      },
      {
        "view": "branchReviewer.files",
        "contents": "Open a folder that contains a git repository to review its branches.",
        "when": "branchReviewer.noRepository"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "branchReviewer.refresh",
          "when": "view == branchReviewer.review",
          "group": "navigation@1"
        },
        {
          "command": "branchReviewer.abort",
          "when": "view == branchReviewer.review && branchReviewer.reviewing",
          "group": "navigation@2"
        },
        {
          "command": "branchReviewer.files.showChangedOnly",
          "when": "view == branchReviewer.files && branchReviewer.reviewing && !branchReviewer.changedOnly",
          "group": "navigation"
        },
        {
          "command": "branchReviewer.files.showAll",
          "when": "view == branchReviewer.files && branchReviewer.reviewing && branchReviewer.changedOnly",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "branchReviewer.openChanges",
          "when": "view == branchReviewer.files && viewItem == changedFile",
          "group": "inline"
        },
        {
          "command": "branchReviewer.openChanges",
          "when": "view == branchReviewer.files && viewItem == changedFile",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "branchReviewer.abort",
          "when": "branchReviewer.reviewing"
        },
        {
          "command": "branchReviewer.openChanges",
          "when": "false"
        },
        {
          "command": "branchReviewer.files.showChangedOnly",
          "when": "branchReviewer.reviewing && !branchReviewer.changedOnly"
        },
        {
          "command": "branchReviewer.files.showAll",
          "when": "branchReviewer.reviewing && branchReviewer.changedOnly"
        }
      ]
    },
    "colors": [
      {
        "id": "branchReviewer.addedForeground",
        "description": "Color of files and lines added by the commit under review.",
        "defaults": {
          "dark": "#3FB950",
          "light": "#1A7F37",
          "highContrast": "#56D364",
          "highContrastLight": "#1A7F37"
        }
      },
      {
        "id": "branchReviewer.modifiedForeground",
        "description": "Color of files and lines modified by the commit under review.",
        "defaults": {
          "dark": "#E3B341",
          "light": "#B08800",
          "highContrast": "#F2CC60",
          "highContrastLight": "#9A6700"
        }
      },
      {
        "id": "branchReviewer.deletedForeground",
        "description": "Color of files and lines deleted by the commit under review.",
        "defaults": {
          "dark": "#F85149",
          "light": "#CF222E",
          "highContrast": "#FF7B72",
          "highContrastLight": "#CF222E"
        }
      },
      {
        "id": "branchReviewer.renamedForeground",
        "description": "Color of files renamed by the commit under review.",
        "defaults": {
          "dark": "#3FB950",
          "light": "#1A7F37",
          "highContrast": "#56D364",
          "highContrastLight": "#1A7F37"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"out/test/unit/**/*.test.js\"",
    "test:integration": "vscode-test",
    "package": "vsce package --allow-missing-repository --skip-license --out dist/$npm_package_name-$npm_package_version.vsix",
    "prepackage": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.139.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
